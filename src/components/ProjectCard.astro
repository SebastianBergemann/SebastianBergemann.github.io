---
import Badge from "./Badge.astro";

interface Props{

title:string;

description:string;

tags:string[];

period:string;

organization:string;

href:string;

}

const{

title,

description,

tags,

period,

organization,

href

}=Astro.props;
---

<article class="card project-card">

<h3>

<a href={href} target="_blank" rel="noopener noreferrer">

{title}

</a>

</h3>

<p class="project-meta">

<span>{period}</span>

<span>{organization}</span>

</p>

<p class="project-description">

{description}

</p>

<div class="badge-row">

{

tags.map(tag=>(

<Badge label={tag}/>

))

}

</div>

</article>
