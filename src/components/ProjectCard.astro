---
import Badge from "./Badge.astro";

interface Props{

title:string;

description:string;

tags:string[];

period:string;

organization:string;

href:string;

logo:string;

partners?:string[];

}

const{

title,

description,

tags,

period,

organization,

href

,logo,

partners=[]

}=Astro.props;
---

<article class="card project-card">

<div class="project-logo-frame">

<img class="project-logo" src={logo} alt={`${title} logo`} />

</div>

<h3>

<a href={href} target="_blank" rel="noopener noreferrer">

{title}

</a>

</h3>

<p class="project-meta">

<span>{period}</span>

<span>{organization}</span>

</p>

{

partners.length>0&&(

<p class="project-partners">

<span>Partners:</span>

<span>{partners.slice(0,10).join(" · ")}</span>

</p>

)

}

<p class="project-description">

{description}

</p>

<!--
<div class="badge-row">

{

tags.map(tag=>(

<Badge label={tag}/>

))

}

</div>
-->

</article>
