---
import Badge from "./Badge.astro";

interface Props{

title:string;

description:string;

tags:string[];

}

const{

title,

description,

tags

}=Astro.props;
---

<div class="card">

<h3>

{title}

</h3>

<p>

{description}

</p>

<div class="badge-row">

{

tags.map(tag=>(

<Badge label={tag}/>

))

}

</div>

</div>