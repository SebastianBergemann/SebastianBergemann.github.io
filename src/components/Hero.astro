---
import Button from "./Button.astro";
---

<section class="hero container">

    <img
        src="/images/profile.jpg"
        alt="Profile picture"
        class="profile-image"
        width="1225"
        height="1270"
    />

    <div>
        <h1>
            Sebastian Bergemann
        </h1>

        <h2>
            Researcher • Software Engineer • PhD Candidate
        </h2>

        <p>
            I am a researcher and software engineer interested in how we can build complex software systems that are reliable, maintainable, and secure. 
            My work combines software engineering research with practical development, with a focus on turning research ideas into tools and solutions that can be used in real-world projects.
        </p>

        This homepage was last updated on the 29th of August 2026.
        <br>
        <br>

        <div class="button-row">
            <Button
                href="/files/cv_sebastian_bergemann.pdf"
                primary={true}
            >
                Download CV
            </Button>
            <Button
                href="/cv"
            >
                View career timeline
            </Button>
            <Button
                href="/projects"
            >
                View projects
            </Button>
            <Button
                href="/publications"
            >
                View publications
            </Button>
        </div>

    </div>

</section>
