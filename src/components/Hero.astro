---
import Button from "./Button.astro";
---

<section class="hero container">

    <img
        src="/images/profile.jpg"
        alt="Profile picture"
        class="profile-image"
        width="1225"
        height="1270"
    />

    <div>
        <h1>
            Sebastian Bergemann
        </h1>

        <h2>
            Researcher • Software Engineer • PhD Candidate
        </h2>

        <p>
            <b>This site is currently under construction. It will be updated with more content in the future.</b>
            <br><br>
			TODOs:
			<ul class="cv-detail-list">
            <li>Fill projects.</li>
			<li>Update hero section and interests.</li>
			<li>Update CV PDF.</li>
            </ul> 
        </p>

        <div class="button-row">
            <Button
                href="/files/cv_sebastian_bergemann.pdf"
                primary={true}
            >
                Download CV
            </Button>
            <Button
                href="/cv"
            >
                View career timeline
            </Button>
            <Button
                href="/projects"
            >
                View projects
            </Button>
            <Button
                href="/publications"
            >
                View publications
            </Button>
        </div>

    </div>

</section>
