---
interface Props {
    title: string;
    venue: string;
    year: string;
    date?: string;
    featured?: boolean;
    type?: "default" | "book" | "journal" | "conference";
    authors?: string;
    doi?: string;
}

const {
    title,
    venue,
    year,
    date,
    featured = false,
    type = "default",
    authors,
    doi,
} = Astro.props;

const iconMap = {
    default: "fa-solid fa-file-lines",
    book: "fa-solid fa-book",
    journal: "fa-solid fa-newspaper",
    conference: "fa-solid fa-chalkboard-user",
};

const typeLabelMap = {
    default: "Preprint",
    book: "Book chapter",
    journal: "Journal article",
    conference: "Conference paper",
};

const authorSelfName = "Sebastian Bergemann";
const authorsList = authors?.split(";").map((author) => author.trim()).filter(Boolean) ?? [];
---

<div class="timeline-item">

    <div class="timeline-marker">
        <span class="timeline-bubble">{year}</span>
    </div>

    <div class="card publication-card">

        <div class="publication-card-head">

            <span class="publication-type-icon">
                <i class={iconMap[type]}></i>
            </span>

            <div class="publication-card-copy">

                {featured && <span class="publication-featured">Featured work</span>}

                <p class="publication-type-label">{typeLabelMap[type]}</p>

                <h3>
                    {title}
                </h3>
                
                <ul class="cv-detail-list publication-detail-list">
                    <li>
                        <strong>Date:</strong> {date ?? year}
                    </li>

                    <li>
                        <strong>Venue:</strong> {venue}
                    </li>

                    {authorsList.length > 0 && (
                        <li>
                            <strong>Authors: </strong>
                            {authorsList.map((author, index) => (
                                <>
                                    {author === authorSelfName ? (
                                        <span class="publication-author-self">{author}</span>
                                    ) : (
                                        author
                                    )}
                                    {index < authorsList.length - 1 && <span>; </span>}
                                </>
                            ))}
                        </li>
                    )}

                    <li>
                        <strong>DOI/URL: </strong>
                        <a
                            href={doi ? (doi.startsWith("http") ? doi : `https://doi.org/${doi}`) : "#"}
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            {doi ?? "N/A"}
                        </a>
                    </li>
                </ul>

            </div>

        </div>

    </div>

</div>