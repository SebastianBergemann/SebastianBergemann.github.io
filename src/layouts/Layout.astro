---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { socialLinks } from "../data/socialLinks";

import "../styles/global.css";

export interface Props {
    title: string;
    description?: string;
    isProfilePage?: boolean;
}

const {
    title,
    description = "Personal homepage of Sebastian Bergemann: profile, projects, publications, curriculum vitae, and contact information.",
    isProfilePage = false
} = Astro.props;

const site = Astro.site ?? new URL(Astro.url.origin);
const canonicalURL = new URL(Astro.url.pathname, site);
const imageURL = new URL("/images/profile.jpg", site);
const sitemapURL = new URL("/sitemap-index.xml", site);

const structuredData = isProfilePage
    ? JSON.stringify({
        "@context": "https://schema.org",
        "@graph": [
            {
                "@type": "WebSite",
                "@id": `${site.href}#website`,
                "url": site.href,
                "name": "Sebastian Bergemann",
                "inLanguage": "en"
            },
            {
                "@type": "ProfilePage",
                "@id": `${canonicalURL.href}#profile`,
                "url": canonicalURL.href,
                "name": title,
                "mainEntity": { "@id": `${site.href}#person` }
            },
            {
                "@type": "Person",
                "@id": `${site.href}#person`,
                "name": "Sebastian Bergemann",
                "url": site.href,
                "image": imageURL.href,
                "sameAs": socialLinks.map(({ url }) => url)
            }
        ]
    })
    : undefined;
---

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8" />

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    />

    <title>{title}</title>

    <meta
        name="description"
        content={description}
    />

    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href={sitemapURL} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Sebastian Bergemann" />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:alt" content="Portrait of Sebastian Bergemann" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content="Portrait of Sebastian Bergemann" />

    <meta
        name="author"
        content="Sebastian Bergemann"
    />

    <meta
        id="theme-color"
        name="theme-color"
        content="#2563eb"
    />

    <script is:inline>
        try {
            const savedTheme = localStorage.getItem("theme");
            const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
            document.documentElement.dataset.theme = savedTheme ?? (prefersDark ? "dark" : "light");
        } catch {
            document.documentElement.dataset.theme = "light";
        }
        document.querySelector("#theme-color").setAttribute(
            "content",
            document.documentElement.dataset.theme === "dark" ? "#111827" : "#f8fafc"
        );
    </script>

    <!-- Favicon -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
	<link rel="alternate icon" href="/favicon.ico" />

    <!-- Inter Font -->
    <link
        rel="preconnect"
        href="https://fonts.googleapis.com"
    />

    <link
        rel="preconnect"
        href="https://fonts.gstatic.com"
        crossorigin
    />

    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
        rel="stylesheet"
    />

    <!-- Font Awesome -->
    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
    />

    <!-- Academicons -->
    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/gh/jpswalsh/academicons@1/css/academicons.min.css"
    />

    {structuredData && <script type="application/ld+json" set:html={structuredData} />}

</head>

<body>

    <Header />

    <main>
		<slot />
	</main>

    <Footer />

    <script is:inline>
        const themeToggle = document.querySelector(".theme-toggle");
        const root = document.documentElement;
        const themeColor = document.querySelector("#theme-color");

        const updateThemeControl = () => {
            const isDark = root.dataset.theme === "dark";
            themeToggle.setAttribute("aria-pressed", String(isDark));
            themeToggle.setAttribute("aria-label", `Switch to ${isDark ? "light" : "dark"} mode`);
            themeToggle.querySelector("span").textContent = isDark ? "☀" : "◐";
            themeColor.setAttribute("content", isDark ? "#111827" : "#f8fafc");
        };

        updateThemeControl();

        themeToggle.addEventListener("click", () => {
            root.dataset.theme = root.dataset.theme === "dark" ? "light" : "dark";
            localStorage.setItem("theme", root.dataset.theme);
            updateThemeControl();
        });
    </script>

</body>

</html>
