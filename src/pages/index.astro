---
import Layout from "../layouts/Layout.astro";

import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
---

<Layout
    title="Sebastian Bergemann — Personal Homepage"
    description="Personal homepage of Sebastian Bergemann: profile, projects, publications, curriculum vitae, and contact information."
    isProfilePage={true}
>

<Hero />

<section class="container">

    <Section title="Research Interests">

        <div class="grid">

            <div class="card">

                <h3>Model-Based Systems Engineering</h3>

                <p>
                    Research on using models as a central means for designing, analyzing, and managing complex software and systems. 
                    My work explores methods and tools that support consistency, automation, and efficient development based on models.
                </p>

            </div>

            <div class="card">

                <h3>Confidential Computing</h3>

                <p>
                    Exploring techniques for protecting sensitive data and software during computation. 
                    This includes trusted execution environments and approaches for securely executing and integrating software components in distributed systems.
                    <br>
                    Currently, I do this specifically in the context of confidentiality preservation durign/for multi-model consistency checking.
                </p>

            </div>

            <div class="card">

                <h3>Software Engineering</h3>

                <p>
                    Research and development of methods, tools, and technologies for building reliable and maintainable software. 
                    My interests include automated analysis, development processes, and applying research results to practical software projects.
                </p>

            </div>

        </div>

    </Section>

</section>

</Layout>
