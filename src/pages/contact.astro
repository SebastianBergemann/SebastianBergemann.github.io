---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import { socialLinks } from "../data/socialLinks";
---

<Layout title="Contact">

<section class="container">

<Section title="Contact">

<div class="contact-cluster">

    <div class="contact-cluster-header">

        <span>Email</span>

    </div>

    <div class="contact-grid">

        <div class="contact-card">

            <div class="contact-card-top">

                <div class="contact-brand">

                    <span class="contact-icon">
                        <i class="fa-solid fa-building"></i>
                    </span>

                    <div class="contact-brand-copy">

                        <span class="contact-label">fortiss</span>
                        <span class="contact-name">fortiss GmbH - Research Institute of the Free State of Bavaria for software-intensive systems</span>

                    </div>

                </div>

            </div>

            <div class="contact-email-row">

                <a class="contact-email" href="mailto:bergemann@fortiss.org">
                    bergemann@fortiss.org
                </a>

                <button
                    class="copy-button"
                    type="button"
                    data-copy="bergemann@fortiss.org"
                    aria-label="Copy Fortiss email address"
                >
                    Copy
                </button>

            </div>

            <div class="contact-detail-list">

                <span class="contact-city">Munich</span>
                <span class="contact-street">Guerickestr. 25, 80805 Munich, Germany</span>

            </div>

        </div>

        <div class="contact-card">

            <div class="contact-card-top">

                <div class="contact-brand">

                    <span class="contact-icon">
                        <i class="fa-solid fa-graduation-cap"></i>
                    </span>

                    <div class="contact-brand-copy">

                        <span class="contact-label">TUM</span>
                        <span class="contact-name">Technical University of Munich</span>

                    </div>

                </div>

            </div>

            <div class="contact-email-row">

                <a class="contact-email" href="mailto:sebastian.bergemann@tum.de">
                    sebastian.bergemann@tum.de
                </a>

                <button
                    class="copy-button"
                    type="button"
                    data-copy="sebastian.bergemann@tum.de"
                    aria-label="Copy TUM email address"
                >
                    Copy
                </button>

            </div>

            <div class="contact-detail-list">

                <span class="contact-city">Munich</span>
                <span class="contact-street">Arcisstr. 21, 80333 Munich, Germany</span>

            </div>

        </div>

    </div>

</div>

<div class="contact-cluster-header social-cluster-header">

    <span>Academic / Social Profiles</span>

</div>

<div class="social-grid">

{

socialLinks.map(link => (

<a
    class="social-card"
    href={link.url}
    target="_blank"
    rel="noopener noreferrer"
>

    <div class="social-icon">
        <i class={link.icon}></i>
    </div>

    <div class="social-content">

        <h3>{link.name}</h3>

        <p>{link.description}</p>

    </div>

    <i class="fa-solid fa-arrow-up-right-from-square external-icon"></i>

</a>

))

}

</div>

</Section>

</section>

<script is:inline>
    const copyButtons = document.querySelectorAll(".copy-button");

    copyButtons.forEach((button) => {
        button.addEventListener("click", async (event) => {
            event.preventDefault();
            event.stopPropagation();

            const value = button.dataset.copy;

            try {
                await navigator.clipboard.writeText(value);
                const previousText = button.textContent;
                button.textContent = "Copied";
                button.classList.add("copied");

                window.setTimeout(() => {
                    button.textContent = previousText;
                    button.classList.remove("copied");
                }, 1200);
            } catch {
                button.textContent = "Copy failed";
                button.classList.add("copied");

                window.setTimeout(() => {
                    button.textContent = "Copy";
                    button.classList.remove("copied");
                }, 1200);
            }
        });
    });
</script>

</Layout>